# QuizForge backend environment variables
#
# Not used yet in Phase 2 (the /api/quiz endpoint currently returns a
# hardcoded quiz). This will be read by quiz_generator.py once the real
# LLM integration is added in Phase 4.
#
# To use it later: copy this file to `.env` in the backend/ folder and
# fill in a real key. `.env` itself should never be committed to git.

LLM_API_KEY=your-api-key-here
